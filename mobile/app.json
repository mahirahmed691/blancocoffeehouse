{
  "expo": {
    "name": "blanco.",
    "slug": "blancocoffeehouse",
    "scheme": "blanco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E9E1D8",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E9E1D8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blancocoffeehouse.app",
      "backgroundColor": "#E9E1D8",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "blanco.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blancocoffeehouse.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E9E1D8"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "blanco",
              "host": "pay"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#E9E1D8"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9E1D8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "blanco. uses your photos so you can check in with a cup from the roll.",
          "cameraPermission": "blanco. uses the camera so you can check in with your cup.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63024ebc-97ec-4357-8c74-ee9ba8ad0165"
      }
    },
    "owner": "mahir93",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/63024ebc-97ec-4357-8c74-ee9ba8ad0165"
    }
  }
}
